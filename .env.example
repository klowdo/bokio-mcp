# Bokio MCP Server Configuration
# Copy this file to .env and fill in your values

# Required - Integration Token from the Bokio app (Settings > Integrations > private integration)
BOKIO_INTEGRATION_TOKEN=your_integration_token_here

# Optional - API configuration
BOKIO_BASE_URL=https://api.bokio.se

# Optional - Security settings
BOKIO_READ_ONLY=false
